# Shared secret. Used for the web login AND as the bearer token for iOS Shortcuts.
# Generate one: node -e "console.log(crypto.randomUUID().replace(/-/g,''))"
TWIN_TOKEN=change-me-to-a-long-random-string

# Anthropic API key. Without it the twin still runs, captures, and stores —
# it just cannot think. Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional overrides
PORT=8787
TWIN_MODEL=claude-opus-5
TWIN_DB=./data/twin.db
TWIN_PROFILE_DIR=./profile
